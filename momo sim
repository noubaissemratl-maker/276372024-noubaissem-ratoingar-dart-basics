int momoFee(int amount) {
  // by NR
  if (amount <= 0) return -1;
  if (amount <= 1000) return 20;
  if (amount <= 10000) return 100;
  if (amount <= 150000) return 250;
  return 1500;
}

// 1. Comma every 3 digits + " RWF"
String formatRwf(int amount) {
  // by NR
  bool negative = amount < 0;
  String digits = amount.abs().toString();
  String result = '';
  int count = 0;
  int i = digits.length - 1;
while (i >= 0) {
    result = digits[i] + result;
    count++;
    if (count % 3 == 0 && i > 0) {
      result = ',$result';
    }
    i--;
  }
  return '${negative ? '-' : ''}$result RWF';
}

// 2. PIN validation
bool isValidPin(String pin) {
  // by NR
  if (pin.length != 5) return false;
  int i = 0;
  while (i < pin.length) {
    int code = pin.codeUnitAt(i);
    if (code < 48 || code > 57) return false; // not a digit 0-9
    i++;
  }
  if (pin == '12345') return false;
  bool allSame = true;
  i = 1;
  while (i < pin.length) {
if (pin[i] != pin[0]) allSame = false;
    i++;
  }
  return !allSame;
}

// 3. Send money (returns the new balance)
int sendMoney(int balance, int amount) {
  // by NR
  int fee = momoFee(amount);
  if (fee == -1) {
    print('Failed: invalid amount');
    return balance;
  }
  if (amount + fee > balance) {
    print('Failed: insufficient balance');
    return balance;
  }
  int newBalance = balance - amount - fee;
  print('Sent ${formatRwf(amount)} (fee ${formatRwf(fee)}). '
      'New balance: ${formatRwf(newBalance)}');
  return newBalance;
}

// 4. Buy airtime (no fee)
int buyAirtime(int balance, int amount) {
/ by NR
  if (amount < 100 || amount > 50000) {
    print('Failed: airtime must be between 100 RWF and 50,000 RWF');
    return balance;
  }
  if (amount > balance) {
    print('Failed: insufficient balance');
    return balance;
  }
  int newBalance = balance - amount;
  print('Airtime bought: ${formatRwf(amount)}. '
      'New balance: ${formatRwf(newBalance)}');
  return newBalance;
}

